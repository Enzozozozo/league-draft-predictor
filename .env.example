# Riot Games Developer API Configuration
# Get your personal key instantly at https://developer.riotgames.com/
# Leave as default or with RGAPI-MOCK-... to run in offline mock mode with a fake key.
RIOT_API_KEY=RGAPI-MOCK-DEV-KEY-0000-000000000000

# Regional routing configurations
RIOT_PLATFORM=sg2
RIOT_REGION=sea

# Set to true to force mock mode even if a real key is present
RIOT_USE_MOCK=false
